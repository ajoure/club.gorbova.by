# Alternate access contour for a small team that cannot reliably reach the
# Lovable edge directly. Canonical production hosts and their DNS stay intact.
#
# Install this file only after the matching application SHA and Edge Functions
# have been published. Each alias must have an exact A record to the VPS.

a.gorbova.by {
	header X-Robots-Tag "noindex, nofollow, noarchive"
	reverse_proxy https://185.158.133.1 {
		header_up Host gorbova.by
		transport http {
			tls_server_name gorbova.by
		}
	}
}

